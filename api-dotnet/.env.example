ConnectionStrings__DefaultConnectionString=Host=localhost;Port=5433;Database=boiler_plate_db;Username=postgres;Password=Test123$
Jwt__SecretKey=CHANGE_ME_TO_A_32_CHAR_MINIMUM_SECRET_KEY
Jwt__ExpireInMinute=15
Redis__Configuration=localhost:6379
Waitlist__CancellationTokenSecret=CHANGE_ME_TO_A_32_CHAR_MINIMUM_SECRET_KEY
FrontendUrl__WaitlistVerify=http://localhost:3000/verify
FrontendUrl__WaitlistCancel=http://localhost:3000/waitlist/cancel
FrontendUrl__WaitlistJoin=http://localhost:3000/waitlist
# Optional: allowlisted frontend origins (comma-separated, or __0/__1 array form). When a waitlist
# request's Origin/Referer matches one of these, emailed links use that origin (keeping the path
# above) so a request from the test frontend gets a test link instead of the configured prod host.
# Anything not listed — including a spoofed header — falls back to the URLs above. Leave empty to
# disable and always use the configured URLs.
FrontendUrl__AllowedOrigins=
# Optional email branding. AssetsBase is the public base URL the email images are served from —
# templates append their own filenames (vulnwatch-logo.png, vulnwatch-mascot.png, social-x.png,
# social-facebook.png, social-linkedin.png). Home is the "Back to Home" button target. All optional:
# unset values degrade to a text wordmark, no mascot and no button rather than failing the send.
# Local dev values below; in production set these to the live host, e.g.
#   FrontendUrl__AssetsBase=https://vulnwatch.com.ng/email
#   FrontendUrl__Home=https://vulnwatch.com.ng
FrontendUrl__AssetsBase=http://localhost:3000/email
FrontendUrl__Home=http://localhost:3000
# Dashboard is the "Go to Dashboard" button on the already-registered notice (falls back to Home
# when unset); PasswordReset backs its "Reset it here." link, which is hidden entirely if unset.
FrontendUrl__Dashboard=http://localhost:3000/dashboard
FrontendUrl__PasswordReset=http://localhost:3000/forgot-password
# Optional footer social links. Only the ones set here are rendered.
Social__X=
Social__Facebook=
Social__LinkedIn=
# Optional: per-recipient cooldown (seconds) for waitlist emails an anonymous caller can trigger
# (resend, cancellation-link request, already-joined / already-registered notices). Default: 60.
Waitlist__EmailCooldownSeconds=60
# SMTP (outbound email). Host/Port/Username/Password/FromName are all required — if any is
# missing or the port is not 1-65535, EmailService logs an error and silently drops the email.
# The client uses STARTTLS (SmtpClient + EnableSsl), so use 587 / 2525 / 25 — NOT the implicit
# TLS port 465, which System.Net.Mail does not support. Username doubles as the From address.
SmtpCredentials__Host=smtp.mailgun.org
SmtpCredentials__Port=587
SmtpCredentials__Username=postmaster@mg.yourdomain.com
SmtpCredentials__Password=
SmtpCredentials__FromName=VulnWatch

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
