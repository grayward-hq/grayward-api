# ===================================================================
# DATABASE
# ===================================================================
DB_URL=jdbc:postgresql://localhost:5432/vulnwatch_db
DB_USERNAME=postgres
DB_PASSWORD=root

# ===================================================================
# REDIS
# ===================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ===================================================================
# QUEUES
# ===================================================================
WORKER_SCANJOB_QUEUE=scan-jobs
WORKER_DOMAIN_RESULT_QUEUE=domain-intel
WORKER_DLQ_KEY=worker-dlq

# ===================================================================
# GITHUB
# ===================================================================
GITHUB_TOKEN=placeholder

# ===================================================================
# AI PROVIDER
# ===================================================================
# Set to: openai | groq | anthropic | gemini
# Must match the uncommented dependency in pom.xml

# ── Using OpenAI ─────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Using Groq (free — comment OpenAI lines above, uncomment below) ──
# AI_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai

# ── Using Anthropic Claude (comment others, uncomment below) ─────────
# Also uncomment spring-ai-starter-model-anthropic in pom.xml


# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=800

# ── Using Google Gemini (comment others, uncomment below) ────────────
# Also uncomment spring-ai-starter-model-google-genai in pom.xml
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# ===================================================================
# SCAN TOOLS
# ===================================================================
DNSRECON_BINARY=dnsrecon
NMAP_BINARY=nmap
NUCLEI_BINARY=nuclei
SUBFINDER_BINARY=subfinder
TESTSSL_BINARY=testssl
TRIVY_BINARY=trivy
TOOLS_TEMP=/tmp/vulnwatch